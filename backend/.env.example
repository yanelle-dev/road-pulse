# Конфигурация сервиса «Дорожный пульс» (Road Pulse API)

# Окружение: development | production
APP_ENV=development

# Порт HTTP-сервера (внутри контейнера по умолчанию 8000, на хосте проксируется на 8001)
PORT=8000

# Строка подключения к PostgreSQL/PostGIS
DATABASE_URL=postgresql://admin:password123@localhost:5432/road_pulse_db?sslmode=disable

# Секретный ключ подписи JWT (обязателен, сгенерируйте стойкий 256-битный ключ)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Базовый адрес инстанса OSRM для сопоставления треков (поддерживаются OSRM_BASE и OSRM_BASE_URL)
OSRM_BASE=https://router.project-osrm.org
OSRM_BASE_URL=https://router.project-osrm.org

# Шлюз SMS (в production при отсутствии ключа сервер падает с ошибкой)
SMS_API_KEY=
SMS_SENDER=RoadPulse